# CloudPulse Global Environment Settings

ENVIRONMENT=local
LOG_LEVEL=INFO

# Authentication Configuration
JWT_SECRET=super-secret-cloudpulse-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Service Port Allocations
AUTH_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
INVENTORY_SERVICE_PORT=8003

# Database Connection URLs (SQLite for local dev/tests, PostgreSQL for containerized/k8s)
AUTH_DB_URL=sqlite:///./auth_service.db
ORDER_DB_URL=sqlite:///./order_service.db
INVENTORY_DB_URL=sqlite:///./inventory_service.db

# Message Broker Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=cloudpulse.events
RABBITMQ_ORDER_CREATED_QUEUE=inventory.order-created.queue

# Observability Configuration
PROMETHEUS_URL=http://localhost:9090
