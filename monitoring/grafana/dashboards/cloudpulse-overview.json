  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Microservices HTTP Request Rate (req/sec)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "id": 1,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_requests_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Latency P95 (seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "id": 2,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, service))",
          "legendFormat": "{{service}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Error Count (4xx / 5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_requests_errors_total[1m])) by (service, status_code)",
          "legendFormat": "{{service}} (HTTP {{status_code}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ML Anomaly Score",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cloudpulse_ml_anomaly_score",
          "legendFormat": "{{target_service}} Anomaly Score"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Automated Remediation Actions Triggered",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "id": 5,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(cloudpulse_remediation_actions_total) by (target_service, action)",
          "legendFormat": "{{target_service}} - {{action}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cloudpulse", "microservices", "ml", "remediation"],
